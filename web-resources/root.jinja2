<link rel="stylesheet" href="{{ static("base.css") }}">
{% endblock %}

{% block content %}
{% endblock %}

{% block after %}

<script>
// Smoke canvas effect
(function() {
  const canvas = document.getElementById('smokeCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let width, height;
  const particles = [];
  const maxParticles = 30;

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  }

  class Particle {
    constructor() {
      this.reset();
    }
    reset() {
      this.x = Math.random() * width;
      this.y = height + Math.random() * 200;
      this.vx = (Math.random() - 0.5) * 0.5;
      this.vy = -Math.random() * 1.5 - 0.5;
      this.radius = Math.random() * 150 + 100;
      this.opacity = 0;
      this.life = 0;
      this.maxLife = Math.random() * 300 + 200;
    }
    update() {
      this.x += this.vx;
      this.y += this.vy;
      this.life++;
      if (this.life < 50) {
        this.opacity = Math.min(0.15, this.life / 50 * 0.15);
      } else if (this.life > this.maxLife - 50) {
        this.opacity = Math.max(0, (this.maxLife - this.life) / 50 * 0.15);
      }
      if (this.life > this.maxLife || this.y < -this.radius) {
        this.reset();
      }
    }
    draw() {
      const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
      gradient.addColorStop(0, `rgba(196, 30, 58, ${this.opacity})`);
      gradient.addColorStop(1, 'rgba(196, 30, 58, 0)');
      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  resize();
  window.addEventListener('resize', resize);

  for (let i = 0; i < maxParticles; i++) {
    const p = new Particle();
    p.life = Math.random() * p.maxLife;
    particles.push(p);
  }

  function animate() {
    ctx.clearRect(0, 0, width, height);
    particles.forEach(p => {
      p.update();
      p.draw();
    });
    requestAnimationFrame(animate);
  }

  animate();
})();

// Embers canvas effect
(function() {
  const canvas = document.getElementById('embersCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let width, height;
  const embers = [];
  const maxEmbers = 50;

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  }

  class Ember {
    constructor() {
      this.reset();
    }
    reset() {
      this.x = Math.random() * width;
      this.y = height + 10;
      this.vx = (Math.random() - 0.5) * 1;
      this.vy = -Math.random() * 2 - 1;
      this.size = Math.random() * 3 + 1;
      this.opacity = Math.random() * 0.8 + 0.2;
      this.life = 0;
      this.maxLife = Math.random() * 200 + 100;
    }
    update() {
      this.x += this.vx + Math.sin(this.life * 0.05) * 0.5;
      this.y += this.vy;
      this.life++;
      if (this.life > this.maxLife || this.y < -10) {
        this.reset();
      }
    }
    draw() {
      ctx.fillStyle = `rgba(196, 30, 58, ${this.opacity})`;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  resize();
  window.addEventListener('resize', resize);

  for (let i = 0; i < maxEmbers; i++) {
    const e = new Ember();
    e.y = Math.random() * height;
    embers.push(e);
  }

  function animate() {
    ctx.clearRect(0, 0, width, height);
    embers.forEach(e => {
      e.update();
      e.draw();
    });
    requestAnimationFrame(animate);
  }

  animate();
})();

// Intro animation
setTimeout(() => {
  document.getElementById('intro').classList.add('hidden');
}, 3500);

// Hero visibility on load
setTimeout(() => {
  const hero = document.getElementById('home');
  if (hero) hero.classList.add('visible');
}, 3200);
</script>

